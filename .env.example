# Copy this file to .env and fill it in. .env is gitignored, so it never gets committed.
#
# Tapo cameras only open their RTSP stream after you create a "Camera Account":
#   Tapo app > your camera > Settings (gear) > Advanced Settings > Camera Account
# (On newer firmware, also turn on "Third-Party Compatibility" if you see it.)
# This is a separate username/password from your TP-Link cloud login.

CAMERA_HOST=192.168.1.100
CAMERA_USER=
CAMERA_PASSWORD=

# stream1 = full quality (2K on a C120), stream2 = low-res 360p
CAMERA_STREAM=stream1
